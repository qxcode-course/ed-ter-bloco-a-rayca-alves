            "label": "2026-04-08_14-44-54",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc ri(inf, sup int) float64 {\n\treturn float64(rand.Intn(sup-inf+1) + inf)\n}\nfunc embua(pen *Pen, dist int){\n\tif dist > 30{\n\t\treturn\n\t}\n\tpen.SetRGB(90, 0, 100)\n\tpen.Walk(dist)\n\tpen.Right(90)\n\tpen.walk(dist)\n\n}\n/*func arvere(pen *Pen, dist float64) {\n\tif dist < 10 {\n\t\tif ri(0, 50) == 0 {\n\t\t\tpen.SetRGB(150, 0, 50)\n\t\t\tpen.FillCircle(10)\n\t\t}\n\t\treturn\n\t}\n\tang_dir := ri(10, 40)\n\tang_esq := ri(10, 40)\n\n\tpen.SetLineWidth(dist / 5)\n\tpen.SetRGB(0, 100, )\n\tpen.Walk(dist)\n\tpen.Right(ang_dir)\n\tarvere(pen, dist*(ri(80, 85)/100))\n\tpen.Left(ang_dir + ang_esq)\n\tarvere(pen, dist*(ri(80, 85)/100))\n\tpen.Right(ang_esq)\n\tpen.SetRGB(0, 100, 0)\n\tpen.Walk(-dist)\n}\n*/\nfunc main() {\n\tpen := NewPen(600, 500)\n\tpen.SetRGB(255, 0, 0)\n\tpen.SetHeading(0)\n\tpen.SetPosition(100, 100)\n\n\tdist := 300.00\n\n\tembua(pen, dist))\n\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
